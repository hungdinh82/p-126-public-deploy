    {
      "name": "manual_search",
      "description": "Giải thích tính năng, cách dùng, thông số và xử lý sự cố VF8 từ cẩm nang. Không đọc trạng thái hiện tại, không thực hiện thao tác. ",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "anyOf": [
              {
                "maxLength": 1000,
                "minLength": 2,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "requested_vehicle_model": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "pattern": "^VF[0-9]+$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "requested_model_year": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "maximum": 2100,
                    "minimum": 2000,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "question_kind": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "const": "charging_duration",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "charging_mode": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "enum": [
                      "AC",
                      "DC"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true
      },
