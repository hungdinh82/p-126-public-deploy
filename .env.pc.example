VIVI_RUNTIME_PROFILE=pc
VIVI_HOST=127.0.0.1
VIVI_PORT=8787
VIVI_DATA_DIR=./data
VIVI_STORE_AUDIO=false
VIVI_STORE_TRANSCRIPTS=false
VIVI_VEHICLE_PROVIDER=memory

STT_PROVIDER=phowhisper
PHOWHISPER_MODEL=vinai/PhoWhisper-medium
PHOWHISPER_DEVICE=auto
PHOWHISPER_DTYPE=auto
PHOWHISPER_PRELOAD=true

LLM_PROVIDER=rules
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_API_KEY=local
LOCAL_LLM_MODEL=qwen2.5-3b-instruct-q4_k_m.gguf

TTS_PROVIDER=zerotts
ZEROTTS_MODEL=zeroweight-ai/ZeroTTS
ZEROTTS_VOICE=VIVI
ZEROTTS_DEVICE=auto
ZEROTTS_PRELOAD=true

RAG_HANDBOOK_DB=./data/handbooks/handbook.sqlite3
RAG_HISTORY_DB=./data/vivi_rag.sqlite3
