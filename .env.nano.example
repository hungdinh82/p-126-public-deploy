VIVI_RUNTIME_PROFILE=nano
VIVI_HOST=0.0.0.0
VIVI_PORT=8787
VIVI_DATA_DIR=./data
VIVI_STORE_AUDIO=false
VIVI_STORE_TRANSCRIPTS=false
VIVI_VEHICLE_PROVIDER=mqtt

STT_PROVIDER=whisper_cpp
WHISPER_CPP_BINARY=./models/whisper.cpp/build/bin/whisper-cli
WHISPER_CPP_MODEL=./models/whisper.cpp/models/ggml-base.bin
PHOWHISPER_PRELOAD=false

LLM_PROVIDER=local
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_API_KEY=local
LOCAL_LLM_MODEL=qwen2.5-1.5b-instruct-q4_k_m.gguf

# ZeroTTS is disabled from preload on the 4 GB Nano. Start with text output,
# then enable only after measuring peak RSS on the target board.
ZEROTTS_PRELOAD=false

RAG_HANDBOOK_DB=./data/handbooks/handbook.sqlite3
RAG_HISTORY_DB=./data/vivi_rag.sqlite3
