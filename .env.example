# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
VIVI_HOST=127.0.0.1
VIVI_PORT=8787
VIVI_DATA_DIR=./data
VIVI_STORE_AUDIO=true
VIVI_STORE_TRANSCRIPTS=true

# Vehicle transport: memory (default) or mqtt. For MQTT, run
# scripts/setup_mqtt_broker.py; it creates ignored data/mqtt/credentials.env.
VIVI_VEHICLE_PROVIDER=memory
VIVI_VEHICLE_ID=demo-car-1
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TIMEOUT_SECONDS=3

STT_PROVIDER=phowhisper
PHOWHISPER_MODEL=vinai/PhoWhisper-medium
PHOWHISPER_DEVICE=auto

# rules | openai | google | local
LLM_PROVIDER=rules
LLM_TIMEOUT_SECONDS=30

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# OpenAI-compatible local API, for example LM Studio/Ollama/vLLM.
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_API_KEY=local
LOCAL_LLM_MODEL=

TTS_PROVIDER=zerotts
ZEROTTS_MODEL=zeroweight-ai/ZeroTTS
ZEROTTS_VOICE=VIVI
ZEROTTS_DEVICE=cpu
