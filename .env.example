# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
VIVI_HOST=127.0.0.1
VIVI_PORT=8787
VIVI_DATA_DIR=./data
VIVI_STORE_AUDIO=true
VIVI_STORE_TRANSCRIPTS=true

STT_PROVIDER=phowhisper
PHOWHISPER_MODEL=vinai/PhoWhisper-medium
PHOWHISPER_DEVICE=auto
PHOWHISPER_DTYPE=auto
PHOWHISPER_PRELOAD=true
PHOWHISPER_LANGUAGE=vi

# rules | openai | google | local
LLM_PROVIDER=google
LLM_TIMEOUT_SECONDS=30

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.1-flash-lite

# Handbook RAG (VF8 2026, Vietnamese)
RAG_GENERATION_MODEL=gemini-3.1-flash-lite
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBEDDING_DIMENSIONS=768
RAG_DATA_DIR=./data/handbooks
RAG_HISTORY_DB=./data/vivi_rag.sqlite3
RAG_COLLECTION_NAME=vivi_handbook
RAG_DEFAULT_VEHICLE_MODEL=VF8
RAG_DEFAULT_MODEL_YEAR=2026
RAG_DEFAULT_LOCALE=vi_vn

# OpenAI-compatible local API, for example LM Studio/Ollama/vLLM.
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_API_KEY=local
LOCAL_LLM_MODEL=

TTS_PROVIDER=zerotts
ZEROTTS_MODEL=zeroweight-ai/ZeroTTS
ZEROTTS_VOICE=VIVI
ZEROTTS_DEVICE=auto
