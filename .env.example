# Local secrets only. Copy to .env; never commit .env.
# Runtime/model settings belong in config.toml.

# AI log submission (optional)
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log

# Fill only keys for cloud providers you use
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
SONIOX_API_KEY=

# VietMap maps, search and routing (journey panel)
VIETMAP_API_KEY=
# Tilemap consumer key, embedded in the browser to draw the base map
VIETMAP_TILE_KEY=

# ngrok tunnel (used only by scripts/run_ngrok.py)
NGROK_AUTHTOKEN=
NGROK_URL=

# Optional per-machine overrides (uncomment as needed)
# VIVI_HOST=0.0.0.0
# LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
# MQTT_HOST=127.0.0.1

# VieNeu cloud TTS (TTS_PROVIDER=vieneu in config.toml)
VIENEU_API_KEY=
