# Local secrets only. Copy to .env; never commit .env.
# Runtime/model settings belong in config.toml.

# AI log submission (optional)
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log

# Fill only keys for cloud providers you use
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
SONIOX_API_KEY=

# VietMap maps, search and routing (journey panel)
VIETMAP_API_KEY=
# Tilemap consumer key, embedded in the browser to draw the base map
VIETMAP_TILE_KEY=

# ngrok tunnel (used only by scripts/run_ngrok.py)
NGROK_AUTHTOKEN=
NGROK_URL=

# Optional per-machine overrides (uncomment as needed)
# VIVI_HOST=0.0.0.0
# Default VF8 Plus 87.7 kWh profile is approximate simulation data.
# Station locations come from VietMap; this file only enriches charger equipment.
# ENERGY_PROFILE_PATH=data/energy/vf8-plus.json
# CHARGING_STATIONS_PATH=data/energy/charging-stations.json
# Synthetic records are ignored by live charging discovery.
# NAVIGATION_PHARMACY_CATEGORY=
# NAVIGATION_CHARGING_CATEGORY=
# NAVIGATION_CHARGING_SEARCH_SECONDS=8
# NAVIGATION_CHARGING_RADIUS_M=20000
# NAVIGATION_CHARGING_MAX_DETOUR_M=15000
# Real map POIs with unknown equipment may use explicit user-authorized estimates.
# CHARGING_ASSUMPTIONS_ENABLED=true
# CHARGING_ASSUMPTIONS_PATH=data/energy/charging-assumptions.json
# VIVI_TURN_TIMEOUT_SECONDS=45
# SEMANTIC_BUDGET_SECONDS=2.5
# LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
# AI_SERVER_URL=http://192.168.1.100:8789
# AI_SERVER_TOKEN=<token from AI server service.env>
# AI_SERVER_AUTH_REQUIRED=false
# MQTT_HOST=127.0.0.1
# VIVI_VEHICLE_SIMULATOR_URL=http://127.0.0.1:8788

# VieNeu cloud TTS (TTS_PROVIDER=vieneu in config.toml)
VIENEU_API_KEY=

# Internet information: Tavily
TAVILY_API_KEY=
# Hard application cap for basic Tavily search requests per UTC month.
# TAVILY_MONTHLY_LIMIT=900
# INFORMATION_ENABLED=true
# CONVERSATION_ENABLED=true
