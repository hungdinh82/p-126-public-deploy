# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
VIVI_HOST=127.0.0.1
VIVI_PORT=8787
VIVI_RUNTIME_PROFILE=pc
VIVI_DATA_DIR=./data
VIVI_STORE_AUDIO=false
VIVI_STORE_TRANSCRIPTS=false

# Vehicle transport: memory (default) or mqtt. For MQTT, run
# scripts/setup_mqtt_broker.py; it creates ignored data/mqtt/credentials.env.
VIVI_VEHICLE_PROVIDER=memory
VIVI_VEHICLE_ID=demo-car-1
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TIMEOUT_SECONDS=3

# off | phowhisper | whisper_cpp | soniox. Text input is always available.
STT_PROVIDER=off
PHOWHISPER_MODEL=vinai/PhoWhisper-medium
PHOWHISPER_DEVICE=auto
PHOWHISPER_DTYPE=auto
PHOWHISPER_PRELOAD=false
PHOWHISPER_LANGUAGE=vi
WHISPER_CPP_BINARY=./models/whisper.cpp/build/bin/whisper-cli
WHISPER_CPP_MODEL=./models/whisper.cpp/models/ggml-base.bin
FFMPEG_BINARY=ffmpeg
# Soniox cloud STT (STT_PROVIDER=soniox). Keep the key in .env only.
SONIOX_API_KEY=<key của bạn>
SONIOX_MODEL=stt-rt-v5
SONIOX_LANGUAGE_HINTS=vi,en
SONIOX_TIMEOUT_SECONDS=30
# Upper bound for one live microphone session over /api/v1/stt/stream.
SONIOX_STREAM_MAX_SECONDS=60

# rules | openai | google | local | openrouter
LLM_PROVIDER=rules
LLM_TIMEOUT_SECONDS=30

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# OpenRouter (LLM_PROVIDER=openrouter). OpenAI-compatible, many models.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.7-flash
OPENROUTER_REASONING=false
OPENROUTER_MAX_TOKENS=1536

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.1-flash-lite

# Handbook RAG (VF8 2026, Vietnamese)
RAG_GENERATION_MODEL=gemini-3.1-flash-lite
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBEDDING_DIMENSIONS=768
RAG_DATA_DIR=./data/handbooks
RAG_HISTORY_DB=./data/vivi_rag.sqlite3
RAG_HANDBOOK_DB=./data/handbooks/handbook.sqlite3
RAG_COLLECTION_NAME=vivi_handbook
# sqlite | lexical | hybrid
RAG_RETRIEVAL_MODE=sqlite
RAG_DEFAULT_VEHICLE_MODEL=VF8
RAG_DEFAULT_MODEL_YEAR=2026
RAG_DEFAULT_LOCALE=vi_vn
RAG_FINAL_K=5
RAG_HISTORY_TURNS=6
RAG_PROMPT_MAX_CHARACTERS=6000

# OpenAI-compatible local API, for example LM Studio/Ollama/vLLM.
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_API_KEY=local
LOCAL_LLM_MODEL=
LOCAL_LLM_MAX_TOKENS=512

# off | zerotts. Text responses are always available.
TTS_PROVIDER=off
ZEROTTS_MODEL=zeroweight-ai/ZeroTTS
ZEROTTS_VOICE=VIVI
ZEROTTS_DEVICE=auto
ZEROTTS_PRELOAD=false

# ---- Profile recipes -------------------------------------------------
# Text-only development is the active default above.
#
# PC with local speech:
#   VIVI_RUNTIME_PROFILE=pc
#   STT_PROVIDER=phowhisper
#   PHOWHISPER_PRELOAD=true
#   TTS_PROVIDER=zerotts
#   ZEROTTS_PRELOAD=true
#
# Jetson Nano 4 GB (API in container; whisper.cpp/llama.cpp as sidecars):
#   VIVI_RUNTIME_PROFILE=nano
#   VIVI_HOST=0.0.0.0
#   VIVI_VEHICLE_PROVIDER=mqtt
#   STT_PROVIDER=whisper_cpp
#   LLM_PROVIDER=local
#   LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
#   LOCAL_LLM_MODEL=qwen2.5-1.5b-instruct-q4_k_m.gguf
#   TTS_PROVIDER=off
#   RAG_FINAL_K=3
#   RAG_HISTORY_TURNS=3
#   RAG_PROMPT_MAX_CHARACTERS=4000
