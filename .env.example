VIVI_HOST=127.0.0.1
VIVI_PORT=8787
VIVI_DATA_DIR=./data
VIVI_STORE_AUDIO=true
VIVI_STORE_TRANSCRIPTS=true

STT_PROVIDER=phowhisper
PHOWHISPER_MODEL=vinai/PhoWhisper-medium
PHOWHISPER_DEVICE=auto

# rules | openai | google | local
LLM_PROVIDER=rules
LLM_TIMEOUT_SECONDS=30

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# OpenAI-compatible local API, for example LM Studio/Ollama/vLLM.
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_API_KEY=local
LOCAL_LLM_MODEL=

TTS_PROVIDER=zerotts
ZEROTTS_MODEL=zeroweight-ai/ZeroTTS
ZEROTTS_VOICE=maichi
ZEROTTS_DEVICE=cpu

